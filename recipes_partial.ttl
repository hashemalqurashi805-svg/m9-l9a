@prefix :      <http://aispire.example.org/recipes/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ---- Cuisine classes ----
:Italian a :Cuisine ;
    skos:prefLabel "Italian" ;
    skos:altLabel  "italiano" .

:Thai a :Cuisine ;
    skos:prefLabel "Thai" ;
    skos:altLabel  "ไทย" .

:French a :Cuisine ;
    skos:prefLabel "French" ;
    skos:altLabel  "français" .

# Hierarchical relations (Challenge Level 1)
:Italian rdfs:subClassOf :European .
:French rdfs:subClassOf :European .

# ---- Ingredient classes ----
:eggplant a :Ingredient ;
    skos:prefLabel "eggplant" ;
    skos:altLabel  "aubergine" .

:basil a :Ingredient ;
    skos:prefLabel "basil" ;
    skos:altLabel  "sweet basil" .

:chili a :Ingredient ;
    skos:prefLabel "chili" ;
    skos:altLabel  "chile" .

# ---- Authors ----
:authorAlice a :Author ; :name "Alice Romano" .
:authorBruno a :Author ; :name "Bruno Tanaka" .
:authorChloe a :Author ; :name "Chloe Dubois" .
:authorDavid a :Author ; :name "David Smith" .

